#!/bin/bash

# Enhanced pre-push hook with safety checks and flexible confirmation
# This prevents accidental pushes without proper review
#
# NOTE: This script contains ANSI escape sequences and references to FORCE_PUSH
# environment variable. These are intentional development safety guardrails and
# are explicitly allowlisted in .gitleaksignore. They are NOT secrets.
# See .gitleaksignore for more details.

set -e

# Run beads pre-push hook (auto-export JSONL before push)
if command -v bd &>/dev/null; then
  bd hooks run pre-push "$@" || true
fi

# Branch gate: block pushes from main/master unless FORCE_PUSH=yes
current_branch=$(git branch --show-current 2>/dev/null || echo "")
if { [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; } && [ "$FORCE_PUSH" != "yes" ]; then
  echo "\033[0;31m❌ BLOCKED: Direct push to $current_branch is not allowed.\033[0m"
  echo "\033[1;33m💡 Create a feature branch and open a PR instead.\033[0m"
  echo "\033[1;33m   git checkout -b feature/my-change\033[0m"
  echo "\033[1;33m   git push -u origin feature/my-change\033[0m"
  echo "\033[1;33m   gh pr create\033[0m"
  echo ""
  echo "\033[1;33m   Breakglass: FORCE_PUSH=yes git push\033[0m"
  exit 1
fi

# Colors for better readability
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔒 PRE-PUSH GUARDRAIL ACTIVATED${NC}"
echo -e "${BLUE}=================================${NC}"
echo ""

# Check if this is a force push
if [[ "$@" == *"--force"* ]] || [[ "$@" == *"-f"* ]]; then
    echo -e "${RED}⚠️  FORCE PUSH DETECTED!${NC}"
    echo -e "${RED}This will overwrite remote history. Are you absolutely sure?${NC}"
    echo ""
fi

# Show commits being pushed
echo -e "${YELLOW}Commits to be pushed:${NC}"
echo ""
git log --oneline --graph --decorate --color origin/main..HEAD 2>/dev/null | head -10 || git log --oneline --graph --decorate --color -5

echo ""
echo -e "${YELLOW}Files changed in this push:${NC}"
echo ""
git diff --stat origin/main..HEAD 2>/dev/null || git diff --stat HEAD~5..HEAD 2>/dev/null || echo "Unable to show file changes"

echo ""
echo -e "${YELLOW}Running path-based tests:${NC}"
if bun run build:path; then
    echo -e "${GREEN}✅ All tests passed${NC}"
else
    echo -e "${RED}❌ Tests failed${NC}"
    echo -e "${RED}Please fix test failures before pushing${NC}"
    exit 1
fi

echo ""
echo -e "${YELLOW}Running analytics validation:${NC}"
if .github/scripts/validate-analytics.sh; then
    echo -e "${GREEN}✅ Analytics validation passed${NC}"
else
    echo -e "${RED}❌ Analytics validation failed${NC}"
    echo -e "${RED}Please add data-event attributes to interactive elements${NC}"
    echo -e "${YELLOW}Or use: git push --no-verify (not recommended)${NC}"
    exit 1
fi

echo ""
echo -e "${RED}⚠️  PUSH GUARDRAIL: This will deploy changes to production!${NC}"
echo ""
echo -e "${YELLOW}Please confirm you want to proceed:${NC}"
echo "  • Have you tested the build locally? ${GREEN}✅${NC}"
echo "  • Have you reviewed all changes above? ${GREEN}←${NC}"
echo "  • Are you ready to deploy to production? ${GREEN}?${NC}"
echo ""

# Handle different environments
if [ -t 0 ] && [ "$FORCE_PUSH" != "yes" ]; then
    # Interactive terminal - ask for confirmation
    printf -e "${BLUE}Type 'yes' to confirm and push, or anything else to cancel: ${NC}"
    read -r confirm
    
    if [ "$confirm" != "yes" ]; then
        echo ""
        echo -e "${RED}❌ Push cancelled. Changes not deployed.${NC}"
        echo -e "${YELLOW}💡 Run 'git push' again when ready, or use 'FORCE_PUSH=yes git push' for automation.${NC}"
        exit 1
    fi
elif [ "$FORCE_PUSH" = "yes" ]; then
    echo -e "${YELLOW}🚀 Force push enabled via environment variable${NC}"
    echo -e "${YELLOW}Skipping interactive confirmation${NC}"
else
    echo -e "${RED}❌ Cannot read input in this environment${NC}"
    echo -e "${YELLOW}💡 Use 'FORCE_PUSH=yes git push' for automation${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}✅ Push confirmed. Proceeding with deployment...${NC}"
