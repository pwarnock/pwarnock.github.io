#!/bin/bash

# Enhanced pre-push hook with safety checks and flexible confirmation
# This prevents accidental pushes without proper review
#
# NOTE: This script contains ANSI escape sequences and references to FORCE_PUSH
# environment variable. These are intentional development safety guardrails and
# are explicitly allowlisted in .gitleaksignore. They are NOT secrets.
# See .gitleaksignore for more details.

set -e

# Run beads pre-push hook (auto-export JSONL before push)
if command -v bd &>/dev/null; then
  bd hooks run pre-push "$@" || true
fi

# Colors for better readability
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_branch_gate_block() {
  local reason="$1"

  printf '%b\n' "${RED}❌ BLOCKED: ${reason}${NC}"
  printf '%b\n' "${YELLOW}💡 Create a feature branch and open a PR instead.${NC}"
  printf '%b\n' "${YELLOW}   git checkout -b feature/my-change${NC}"
  printf '%b\n' "${YELLOW}   git push -u origin feature/my-change${NC}"
  printf '%b\n' "${YELLOW}   gh pr create${NC}"
  printf '\n'
  printf '%b\n' "${YELLOW}   Breakglass: FORCE_PUSH=yes git push${NC}"
}

# Branch gate: block pushes from protected branches unless FORCE_PUSH=yes.
# Pre-push hook receives lines on stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>
current_branch=$(git branch --show-current 2>/dev/null) || true
protected_remote_branch=""

if [ "$FORCE_PUSH" != "yes" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
      refs/heads/main|refs/heads/master)
        protected_remote_branch="${remote_ref##refs/heads/}"
        break
        ;;
    esac
  done
fi

if [ "$FORCE_PUSH" != "yes" ]; then
  if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
    print_branch_gate_block "Direct push from protected branch ${current_branch} is not allowed."
    exit 1
  fi

  if [ -n "$protected_remote_branch" ]; then
    print_branch_gate_block "Push targets protected branch ${protected_remote_branch}."
    exit 1
  fi
fi

echo -e "${BLUE}🔒 PRE-PUSH GUARDRAIL ACTIVATED${NC}"
echo -e "${BLUE}=================================${NC}"
echo ""

# NOTE: Pre-push hooks receive (remote, url) as $@, not the original git push flags.
# Force push detection here is unreliable — the Claude Code hookify guard handles
# force push blocking before this hook runs.

# Show commits being pushed
echo -e "${YELLOW}Commits to be pushed:${NC}"
echo ""
if ! git log --oneline --graph --decorate --color origin/main..HEAD 2>/dev/null | head -10; then
  echo -e "${YELLOW}⚠  Could not determine commits relative to origin/main.${NC}"
  echo -e "${YELLOW}   Showing recent commits instead (may not reflect actual push):${NC}"
  git log --oneline --graph --decorate --color -5
fi

echo ""
echo -e "${YELLOW}Files changed in this push:${NC}"
echo ""
if ! git diff --stat origin/main..HEAD 2>/dev/null; then
  echo -e "${YELLOW}⚠  Could not determine changes relative to origin/main.${NC}"
  if ! git diff --stat HEAD~5..HEAD 2>/dev/null; then
    echo "Unable to show file changes"
  fi
fi

echo ""
echo -e "${YELLOW}Running path-based tests:${NC}"
if bun run build:path; then
    echo -e "${GREEN}✅ All tests passed${NC}"
else
    echo -e "${RED}❌ Tests failed${NC}"
    echo -e "${RED}Please fix test failures before pushing${NC}"
    exit 1
fi

echo ""
echo -e "${YELLOW}Running analytics validation:${NC}"
if .github/scripts/validate-analytics.sh; then
    echo -e "${GREEN}✅ Analytics validation passed${NC}"
else
    echo -e "${RED}❌ Analytics validation failed${NC}"
    echo -e "${RED}Please add data-event attributes to interactive elements${NC}"
    echo -e "${YELLOW}Or use: git push --no-verify (not recommended)${NC}"
    exit 1
fi

echo ""
echo -e "${RED}⚠️  PUSH GUARDRAIL: This will deploy changes to production!${NC}"
echo ""
echo -e "${YELLOW}Please confirm you want to proceed:${NC}"
echo "  • Have you tested the build locally? ${GREEN}✅${NC}"
echo "  • Have you reviewed all changes above? ${GREEN}←${NC}"
echo "  • Are you ready to deploy to production? ${GREEN}?${NC}"
echo ""

# Handle different environments
# Non-interactive environments (CI, Claude Code) skip the confirmation prompt.
# Safety: branch gate blocks main; refspec gate catches detached HEAD; tests ran above.
if [ -t 0 ] && [ "$FORCE_PUSH" != "yes" ]; then
    # Interactive terminal - ask for confirmation
    printf "${BLUE}Type 'yes' to confirm and push, or anything else to cancel: ${NC}"
    read -r confirm

    if [ "$confirm" != "yes" ]; then
        echo ""
        echo -e "${RED}❌ Push cancelled. Changes not deployed.${NC}"
        echo -e "${YELLOW}💡 Run 'git push' again when ready.${NC}"
        exit 1
    fi
elif [ "$FORCE_PUSH" = "yes" ]; then
    echo -e "${YELLOW}🚀 Force push enabled via environment variable${NC}"
    echo -e "${YELLOW}Skipping interactive confirmation${NC}"
else
  # Non-interactive environment (CI, Claude Code, etc.)
  echo -e "${YELLOW}📦 Non-interactive environment detected${NC}"
  if [ -n "$current_branch" ]; then
      echo -e "${YELLOW}Branch '${current_branch}' is not protected — proceeding${NC}"
  else
      echo -e "${YELLOW}Remote refs are not protected — proceeding${NC}"
  fi
fi

echo ""
echo -e "${GREEN}✅ Push confirmed. Proceeding with deployment...${NC}"
