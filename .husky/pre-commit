#!/bin/bash

# Pre-Commit Hook: Quality Gates
#
# This hook:
# 1. Blocks direct commits to protected branches (main)
# 2. Runs linting and validation
# 3. Prevents commit if quality gates fail

set -e

# ============================================================================
# STEP 0: Branch protection — no direct commits to main
# ============================================================================
# Hard block: no env-var bypass. All work must land via a feature branch.
# To update this hook itself on main, a human disables it first:
#   git -c core.hooksPath=/dev/null commit ...
# (that escape route is blocked for agents via the commandDenylist in
# ~/.factory/settings.json).
PROTECTED_BRANCHES="main"
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if echo "$PROTECTED_BRANCHES" | grep -qx "$CURRENT_BRANCH"; then
  echo "❌ Direct commits to '$CURRENT_BRANCH' are blocked by pre-commit hook."
  echo "   Create a feature branch instead:"
  echo "     git checkout -b feat/<your-feature>"
  exit 1
fi

# Run beads pre-commit hook (auto-flush, export JSONL)
if command -v bd &>/dev/null; then
  bd hooks run pre-commit "$@" || true
fi

echo ""
echo "🔍 Running pre-commit checks..."
echo ""

# ============================================================================
# STEP 1: Run linting (source CSS only, not generated)
# ============================================================================

echo ""
echo "🎨 Linting CSS..."
if ! bun run lint 2>/dev/null; then
  echo "❌ CSS linting failed"
  exit 1
fi

echo "✅ Linting passed"

# ============================================================================
# STEP 2: Validation
# ============================================================================

echo ""
echo "✔️  Validating files..."
if ! bun run validate --skip-build 2>/dev/null; then
  echo "❌ Validation failed"
  exit 1
fi

echo "✅ Validation passed"

# ============================================================================
# STEP 3: Test build (quick smoke test)
# ============================================================================

echo ""
echo "🔨 Testing build..."
if ! hugo --quiet 2>/dev/null; then
  echo "❌ Build failed"
  exit 1
fi

echo "✅ Build test passed"

# ============================================================================
# SUMMARY
# ============================================================================

echo ""
echo "✅ All pre-commit checks passed!"
echo ""
